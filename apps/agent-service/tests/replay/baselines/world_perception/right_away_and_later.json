  "tool_schemas": {
    "check_current_weather": {
      "description": [
        "查一个真实地方此刻的天气实况：天气现象、气温、体感、湿度、风、近一小时降水、能见度、云量、紫外线。",
        "",
        "交回来的是和风天气认下的那个地方和它的读数。名字有歧义时会列出同名的其他地方。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "place": {
            "description": "要查的那个真实地方的名字",
            "type": "string"
          }
        },
        "required": [
          "place"
        ]
      }
    },
    "check_daily_forecast": {
      "description": [
        "查一个真实地方接下来几天的逐日预报：每天的最高最低气温、日出日落、月出月落和月相，白天和夜里分开说天气现象、降水、风、湿度、云量。",
        "",
        "交回来的是和风天气认下的那个地方和它的预报。名字有歧义时会列出同名的其他地方。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "place": {
            "description": "要查的那个真实地方的名字",
            "type": "string"
          },
          "days": {
            "default": 7,
            "description": "要看接下来几天",
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "place"
        ]
      }
    },
    "check_hourly_forecast": {
      "description": [
        "查一个真实地方接下来逐小时的天气预报：每小时的天气现象、气温、降水概率和降水量、风。",
        "",
        "交回来的是和风天气认下的那个地方和它的预报。名字有歧义时会列出同名的其他地方。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "place": {
            "description": "要查的那个真实地方的名字",
            "type": "string"
          },
          "hours": {
            "default": 24,
            "description": "要看接下来几个小时",
            "maximum": 240,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "place"
        ]
      }
    },
    "let_npc_appear": {
      "description": [
        "让一个 NPC 在一次互动里出场。",
        "",
        "一个临时 agent 依据各来源扮演他，给出他这一次说的话、做的事；这段言行原样交给感知判断，",
        "告知会察觉到的人。返回他的言行和告知了谁。这次互动留下了什么，之后由你记进记录。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "npc": {
            "description": "出场的是谁：他在记录里的名字和身份",
            "type": "string"
          },
          "situation": {
            "description": "这次出场的情境：什么时候、在哪、刚刚发生了什么、谁在跟他打交道。只写情境，不写他要说什么、做什么",
            "type": "string"
          }
        },
        "required": [
          "npc",
          "situation"
        ]
      }
    },
    "list_records": {
      "description": [
        "列出世界的全部记录：每一份的路径、字数、最后改动的时间。",
        "",
        "记录是世界对自己的认识：这个世界坐落在哪个真实的地方，有哪些地方、那里什么样，有哪些人",
        "和机构，什么东西现在处在什么状态。"
      ],
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    "list_senders": {
      "description": "列出给世界发过消息的人：名字、发过几条、最近一条是什么时候。",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    "read_messages_from": {
      "description": [
        "读一个人最近发给世界的消息原文，从新到旧：他们说自己在哪、在做什么、对世界做了什么。",
        "",
        "这是他们自己说的，不是世界确认过的事。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "description": "发消息的人的名字，跟 list_senders 列出来的一字不差",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "read_record": {
      "description": "读世界的一份记录的全文。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "description": "记录的路径，相对记录根目录，形如 目录/名字.md",
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "report_change": {
      "description": [
        "报告世界里发生的一个变化，让会察觉到它的人知道。",
        "",
        "由感知判断决定谁会察觉、各自察觉到的是什么，并告知他们；返回告知了谁、送没送达。",
        "这是让居民知道世界变化的唯一办法。一个变化报告一次。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "change": {
            "description": "世界里发生的一个变化：什么时候、在哪、什么变成了什么样。主语是世界：天气、地方、物件、机构、其他人的处境",
            "type": "string"
          }
        },
        "required": [
          "change"
        ]
      }
    },
    "search_web": {
      "description": [
        "网页搜索，返回搜索结果及其网页内容。",
        "",
        "Args:",
        "    query: 搜索关键词。",
        "    gl: 结果地域代码，默认 \"CN\"。",
        "    hl: 界面语言代码，默认 \"ZH-HANS\"。",
        "    num: 返回结果条数，默认 5。",
        "",
        "Returns:",
        "    搜索结果的文本摘要。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "gl": {
            "default": "CN",
            "type": "string"
          },
          "hl": {
            "default": "ZH-HANS",
            "type": "string"
          },
          "num": {
            "default": 5,
            "description": "返回结果条数",
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    "someone_notices": {
      "description": [
        "判断一个参与者会察觉到这个变化，写下他察觉到的是什么，以及要不要现在就叫他来看。",
        "",
        "每个会察觉的人调一次；同一个人再调一次，以最后一次为准。没有人会察觉，就一次都不调。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "who": {
            "description": "会察觉到的那个参与者，用他在这个世界里的名字",
            "type": "string"
          },
          "what": {
            "description": "他察觉到的是什么：从他的角度写，什么时候、在哪、他看到听到感觉到了什么。这段话会原样发给他",
            "type": "string"
          },
          "right_away": {
            "description": "要不要为这件事现在就打断他，叫他来看。true：现在就打断他，他马上来看这段话；false：不为这件事打断他，这段话照样会交给他，他下一次看的时候看到。不管哪一种，他读到的都是他在那个时刻察觉到的",
            "type": "boolean"
          }
        },
        "required": [
          "who",
          "what",
          "right_away"
        ]
      }
    },
    "wake_me_at": {
      "description": [
        "定下次醒来的时刻。每一轮结束前必须定一次；调了几次以最后一次为准。",
        "",
        "有人找你、或者有消息来，你会被提前叫醒，不用为等消息定时刻。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "at": {
            "description": "下次醒来的时刻，ISO 8601，形如 YYYY-MM-DDTHH:MM；不带时区的按东八区算",
            "type": "string"
          },
          "reason": {
            "description": "为什么定这个时刻。到时候这句话会原样摆在你眼前；时刻跟你原来定的下次醒来相同时，不另排，到时候摆出来的是原来那次写的理由",
            "type": "string"
          }
        },
        "required": [
          "at",
          "reason"
        ]
      }
    },
    "write_record": {
      "description": [
        "整份写下一份记录：没有就新建，有就整份替换。",
        "",
        "改写一份已经有的记录之前，要在这一轮里读过它现在的样子。"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "description": "记录的路径，相对记录根目录，形如 目录/名字.md",
            "type": "string"
          },
          "text": {
            "description": "这一份记录的全文，整份替换原来的",
            "type": "string"
          }
        },
        "required": [
          "path",
          "text"
        ]
      }
    }
  }
}
