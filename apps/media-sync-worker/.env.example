# 集群 Mongo（必需）：chiwei_pixiv 库里的图片目录 pixiv_images、下载队列 pixiv_download_tasks、
# 翻译表 pixiv_tag_translations、作者节流 pixiv_author_downloads。
PIXIV_MONGO_HOST=local-mongo
PIXIV_MONGO_PORT=27017
PIXIV_MONGO_DATABASE=chiwei_pixiv
PIXIV_MONGO_USERNAME=root
PIXIV_MONGO_PASSWORD=your_local_mongo_password_here
PIXIV_MONGO_AUTH_SOURCE=admin
PIXIV_MONGO_CONNECT_TIMEOUT_MS=2000
# socket 不活动超时，默认 60000；0 表示不设（driver 默认无限等待，半开连接会卡死 consumer）
PIXIV_MONGO_SOCKET_TIMEOUT_MS=60000

# 飞书开放平台配置
APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
APP_SECRET=your_feishu_app_secret_here
SELF_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HTTP 服务认证
HTTP_SECRET=your_random_secret_key_here
# 或复用内部 inter-service-auth 配置
# PROXY_HTTP_SECRET=your_random_secret_key_here

# 定时任务配置
# Pixiv 下载任务 cron 表达式，默认每天 10:12
DOWNLOAD_CRON="12 10 * * *"
# 下载等待参数：默认均为旧硬编码等待的一半；需要进一步提速可按压测结果降到 0。
DOWNLOAD_AFTER_ILLUST_INFO_DELAY_MS=1500
DOWNLOAD_BEFORE_PAGE_DOWNLOAD_DELAY_MS=1000
DOWNLOAD_AFTER_TASK_DELAY_MS=2500
DOWNLOAD_AFTER_AUTHOR_DELAY_MS=1500
DOWNLOAD_LIMITER_COOLDOWN_MS=120000

# 阿里云 OSS（读取 pixiv 图片，必须用公网/外网 endpoint，worker 不在阿里云内网）
END_POINT=https://oss-cn-xxxxxx.aliyuncs.com
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
OSS_BUCKET=your_oss_bucket_here

# 自建 MinIO（内网训练缓存，ENDPOINT 用 DNS 名不是 IP）
MINIO_ENDPOINT=minio.prod
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=pixiv
# OSS→MinIO 同步总开关：默认关（不设置 / 任意其它值都视为关）。
# 设为 true（或 1）才开启 per-page 同步；关闭时 worker 退回纯下载、零额外行为。
MINIO_SYNC_ENABLED=false

# Tagger 结果 Mongo（本地 Mongo，复用 channel-server 使用的 Mongo 基础设施）。
TAGGER_RESULT_MONGO_ENABLED=false
TAGGER_RESULT_MONGO_HOST=local-mongo
TAGGER_RESULT_MONGO_PORT=27017
TAGGER_RESULT_MONGO_DATABASE=chiwei_tagger
TAGGER_RESULT_MONGO_USERNAME=root
TAGGER_RESULT_MONGO_PASSWORD=your_local_mongo_password_here
TAGGER_RESULT_MONGO_AUTH_SOURCE=admin
TAGGER_RESULT_MONGO_CONNECT_TIMEOUT_MS=2000

# Tagger 自动触发：开启后，下载完成后先写入 outbox，由后台 worker 同步 MinIO 并提交 tagger-service。
TAGGER_TRIGGER_ENABLED=false
TAGGER_ENTRY_URL=http://tagger-entry.internal:8000
TAGGER_API_TOKEN=your_tagger_caller_token_here
TAGGER_CALLBACK_URL=http://media-sync-worker/internal/tagger/callback
# 每个 tagger task 合并提交的图片数。设为 4 可让 tagger-entry 对 4 张图做一次 batch 推理。
TAGGER_SUBMIT_BATCH_SIZE=4
TAGGER_SUBMIT_TIMEOUT_MS=10000
TAGGER_SUBMIT_RETRIES=2
TAGGER_TRIGGER_WORKER_IDLE_DELAY_MS=5000
TAGGER_TRIGGER_RETRY_DELAY_MS=60000
TAGGER_TRIGGER_PROCESSING_TIMEOUT_MS=600000
TAGGER_TRIGGER_MAX_ATTEMPTS=5
# submitted 任务主动查询远端状态，补偿丢失 callback。
TAGGER_SUBMITTED_RECONCILE_AFTER_MS=600000
TAGGER_SUBMITTED_RECONCILE_LEASE_MS=60000
TAGGER_SUBMITTED_RECONCILE_RETRY_DELAY_MS=60000

# 将 callback 原始结果与派生检索词投影到本地 pixiv_images。
TAGGER_PROJECTION_ENABLED=false
# 只控制无 projection 状态的历史 completed 结果，默认禁止存量回填。
TAGGER_PROJECTION_BACKFILL_ENABLED=false
TAGGER_PROJECTION_BATCH_SIZE=4
TAGGER_PROJECTION_WORKER_IDLE_DELAY_MS=5000
TAGGER_PROJECTION_RETRY_DELAY_MS=60000
TAGGER_PROJECTION_PROCESSING_TIMEOUT_MS=600000

# Tagger callback HTTP 入口。开启后 media-sync-worker 不再是纯 port=0 worker，
# PaaS app 需要配置端口并创建 Service / gateway rule。
TAGGER_CALLBACK_SERVER_ENABLED=false
TAGGER_CALLBACK_PORT=3000
TAGGER_CALLBACK_AUTH_TOKEN=your_tagger_callback_token_here

# 部署验证开关
DISABLE_SCHEDULES=false
DISABLE_CONSUMER=false
RUN_CONNECTIVITY_CHECK=false
DOWNLOAD_DISCOVERY_STEP_TIMEOUT_MS=180000
